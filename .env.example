# ── Database (PostgreSQL) ─────────────────────────────────────────────
# 로컬 개발: `npx prisma dev` 로 임시 Postgres 를 띄우면 URL 을 출력해 준다.
DATABASE_URL="postgresql://user:password@localhost:5432/docufit?schema=public"

# ── Object Storage (AWS S3 또는 S3 호환: Cloudflare R2, MinIO) ──────────
S3_BUCKET="docufit-files"
S3_REGION="ap-northeast-2"
# AWS 가 아닐 때만 지정 (예: https://<account>.r2.cloudflarestorage.com 또는 http://localhost:9000)
# S3_ENDPOINT=""
# MinIO 등 path-style 전용일 때 true
# S3_FORCE_PATH_STYLE="false"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Cleanup cron 보호 ─────────────────────────────────────────────────
# 32자 이상 랜덤 문자열. 예: `openssl rand -hex 32`
CRON_SECRET=""

# ── Retention / Limits ────────────────────────────────────────────────
# 파일 보존 시간(분). PRD 요구사항: 60. 상한도 60 으로 코드에서 강제됨.
FILE_TTL_MINUTES="60"
# 서버 처리 경로 요청 본문 상한(MB)
MAX_UPLOAD_MB="50"
